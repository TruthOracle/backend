# TruthOracle backend — configuration reference (docs/ARCHITECTURE.md §12, src/config.ts).
# Copy to .env for local development. Every key below is read exactly once by
# getConfiguration(); the process REFUSES TO BOOT on any of these:
#   • missing DATABASE_URL / REDIS_URL / NATS_URL
#   • SESSION_SECRET / KYC_FINGERPRINT_PEPPER shorter than 32 chars, or a set
#     BACKEND_PROXY_SECRET shorter than 32 chars
#   • KYC_PROVIDER=mock when APP_ENV=prod OR APP_NETWORK=mainnet
#   • SUMSUB_APP_TOKEN starting with "sbx:" on mainnet
#   • APP_NETWORK=mainnet without the ZKPC_* block
#   • COOKIE_DOMAIN set while BACKEND_PROXY_SECRET is configured (proxied cookies are host-only)
#   • KYC_PROVIDER=sumsub with SUMSUB_APP_TOKEN but no SUMSUB_WEBHOOK_SECRET
#   • APP_ENV=prod or APP_NETWORK=mainnet with unverified Postgres TLS (DB_SSL=true/auto) and no DB_SSL_INSECURE_ACK
#   • to_settings.app_network ≠ APP_NETWORK (database belongs to another network)
#   • to_settings.kyc_pepper_hash ≠ sha256(KYC_FINGERPRINT_PEPPER) without KYC_PEPPER_ROTATION_ACK
# See docs/RUNBOOK.md for the operator procedures behind each refusal.

# ── Process ──────────────────────────────────────────────────────────────────
APP_ENV=dev                        # dev | staging | prod — drives every "auto" below and Sentry environment
APP_NETWORK=devnet                 # devnet | mainnet — Redis key prefix, NATS stream name, ledger credential selection
PORT=8091
LOG_JSON=auto                      # auto (= JSON outside dev) | true | false — Nest ConsoleLogger({ json })

# ── Datastores (all required) ───────────────────────────────────────────────
DATABASE_URL=postgresql://truthoracle:truthoracle@localhost:5432/truthoracle_backend   # docker-compose credentials
DB_MIGRATE_ON_BOOT=true            # run the checked-in TypeORM migrations at startup (synchronize is never used)
DB_SSL=auto                        # auto (off for localhost / docker "postgres" host, unverified TLS otherwise) | true (unverified TLS) | verify (TLS, certificate checked) | false
DB_SSL_CA=                         # DB_SSL=verify only: PEM inline or a file path when the managed Postgres uses a private CA (Railway: not needed)
DB_SSL_INSECURE_ACK=false          # prod / mainnet refuse unverified TLS (DB_SSL=true, or auto against a remote host) unless this is true
REDIS_URL=redis://localhost:6379   # sessions cache + per-user index, challenges, nonces, rate limits, locks, ledger cache
NATS_URL=nats://localhost:4222     # JetStream MUST be enabled (nats-server -js); stream TRUTHORACLE_<APP_NETWORK>

# ── Sessions & cookies ───────────────────────────────────────────────────────
SESSION_SECRET=change-me-to-at-least-32-random-characters-please   # ≥32 chars; generate: openssl rand -hex 32
SESSION_TTL_HOURS=168              # absolute lifetime of user sessions (kind = user)
ADMIN_SESSION_TTL_HOURS=1          # absolute lifetime of wallet-signed admin sessions (kind = admin)
COOKIE_SECURE=auto                 # auto (= Secure outside dev) | true | false
COOKIE_DOMAIN=                     # blank = host-only cookie. MUST stay blank behind the Vercel proxy.
# Origins allowed by the CSRF guard on every non-GET (exact origins or https://*.vercel.app patterns).
FRONTEND_ORIGINS=http://localhost:5173
# Shared secret with truthoracle-canton/api/proxy/backend.mjs (x-truthoracle-proxy). When the header
# matches, x-real-ip / x-forwarded-host are trusted; otherwise socket address + Host are used and every
# x-forwarded-* header is ignored. ≥32 chars when set; blank = never trust proxy headers.
BACKEND_PROXY_SECRET=
# CORS is only for native / non-browser clients (bearer sessions). Browser traffic is same-origin via the proxy.
CORS_ORIGINS=

# ── Google (Identity Services, ID-token flow) ───────────────────────────────
GOOGLE_CLIENT_IDS=                 # comma list of accepted audiences (web + iOS client ids); GOOGLE_CLIENT_ID is read as a single-value alias
GOOGLE_NONCE_REQUIRED=auto         # auto (= required outside dev) | true | false — POST /auth/google/nonce

# ── Telegram (Login Widget, Mini App initData, OIDC) ────────────────────────
TELEGRAM_BOT_TOKEN=                # from BotFather; HMAC key for widget/initData verification
TELEGRAM_BOT_USERNAME=             # without @; the frontend hides the widget when blank
TELEGRAM_AUTH_MAX_AGE_SEC=300      # Login Widget auth_date window
TELEGRAM_INITDATA_MAX_AGE_SEC=3600 # Mini App initData auth_date window
TELEGRAM_OIDC_CLIENT_ID=           # BotFather → Login Widget → OIDC client
TELEGRAM_OIDC_CLIENT_SECRET=
TELEGRAM_OIDC_ISSUER=https://oauth.telegram.org

# ── Operators / admins ───────────────────────────────────────────────────────
# Parties allowed to hold an admin session (purpose = admin-sign-in), comma separated.
# Optional "=publicKey" pins the signing key (hex / base64 / base64url) on top of the fingerprint binding.
# Removing a party revokes its admin sessions on the next request. There is no ADMIN_EMAILS.
ADMIN_OPERATORS=

# ── Canton ledger + Enterprise Wallet (devnet names; mainnet uses ZKPC_* for the ledger) ──
LEDGER_API_URL=                    # Canton JSON Ledger API base (devnet); ignored on mainnet
ENTERPRISE_WALLET_URL=             # Enterprise Wallet REST base (history, transfer, external/submit)
TREASURY_PARTY_ID=                 # party the Enterprise Wallet signs for; reads are done as this party
ENTERPRISE_WALLET_APP_NAME=truthoracle
# The deployed Daml package is truthoracle-v15 1.0.0 — a fresh lineage deployed from scratch. UserWallet.depositRefs : [Text]
# is mandatory (the deposit confirm pass keys on it; a UserWallet read without the field is a 502 upstream_failed) and so
# are the four market identity fields (ticker, eventTicker, yesSubTitle, noSubTitle).
TRUTHORACLE_PACKAGE_ID=                    # package-id form for Create/Exercise commands (pins the version) — printed by `npm run dars:upload` in truthoracle-contracts
TRUTHORACLE_PACKAGE_NAME=truthoracle-v15   # daml.yaml `name:` — active-contracts filters need "#name:Module:Entity"

# ── Keycloak (client_credentials → bearer for ledger + wallet) ──────────────
KEYCLOAK_URL=
KEYCLOAK_REALM=master
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
# Optional per-target overrides; each field falls back to KEYCLOAK_* independently.
LEDGER_KEYCLOAK_URL=
LEDGER_KEYCLOAK_REALM=
LEDGER_KEYCLOAK_CLIENT_ID=
LEDGER_KEYCLOAK_CLIENT_SECRET=
WALLET_KEYCLOAK_URL=               # the wallet trusts its OWN Keycloak on every network
WALLET_KEYCLOAK_REALM=
WALLET_KEYCLOAK_CLIENT_ID=
WALLET_KEYCLOAK_CLIENT_SECRET=
# Mainnet ledger (ALL required when APP_NETWORK=mainnet; the only ledger credentials read there):
ZKPC_LEDGER_API_URL=
ZKPC_KEYCLOAK_URL=
ZKPC_KEYCLOAK_REALM=master
ZKPC_KEYCLOAK_CLIENT_ID=           # alias accepted: ZKPC_CLIENT_ID (the name truthoracle-canton/.env uses)
ZKPC_KEYCLOAK_CLIENT_SECRET=       # alias accepted: ZKPC_CLIENT_SECRET

# ── KYC ─────────────────────────────────────────────────────────────────────
KYC_PROVIDER=mock                  # mock | sumsub — mock is refused in prod and on mainnet; /kyc/mock/* exists only with mock
KYC_ENFORCE_WITHDRAWALS=false      # gate external withdrawal settlement on an approved KYC (plain flag; money leaves only through this backend)
KYC_REQUIRED_LEVEL=basic-kyc-level # provider level name an approval must carry
KYC_FINGERPRINT_PEPPER=change-me-to-at-least-32-random-characters-too   # ≥32 chars; HMAC key for person/doc fingerprints
KYC_PEPPER_ROTATION_ACK=           # sha256 hex of the NEW pepper — acknowledges a pepper rotation (docs/RUNBOOK.md)
# Sumsub (docs/KYC.md §5): dashboard → Dev space → App tokens (View applicants) and Webhooks.
SUMSUB_BASE_URL=https://api.sumsub.com   # same host for sandbox and production; the token decides
SUMSUB_APP_TOKEN=                  # "sbx:" tokens are refused on mainnet
SUMSUB_SECRET_KEY=                 # the app token's secret (shown once at creation)
SUMSUB_WEBHOOK_SECRET=             # webhook secret key; required with KYC_PROVIDER=sumsub once SUMSUB_APP_TOKEN is set (boot refusal otherwise)
SUMSUB_DUPLICATE_LABELS=DUPLICATE  # reject labels that map to blocked_duplicate
SUMSUB_ALLOW_SHA1=false            # accept HMAC_SHA1_HEX webhook digests — Sumsub's DEFAULT is SHA-1, so set the dashboard webhook to HMAC_SHA256_HEX instead
# Probe the wiring from the host: `npm run kyc:check` (or GET /admin/kyc/provider with an operator session).

# ── Payout policy (closed map — anything else is blocked_unknown_reason) ────
PAYOUT_EXTERNAL_REASONS=withdraw   # settled as CC transfers, KYC-gated
PAYOUT_INAPP_REASONS=bond,model-prize   # settled into the payee's in-app UserWallet
PAYOUT_MAX_ATTEMPTS=5              # settling attempts before a row becomes failed (admin queue); system scans never count
PAYOUT_SCAN_MS=30000               # payout-settlement processor scan interval
PAYOUT_RESEND_GRACE_MS=600000      # row age before an operator's force may re-send a transfer the wallet says it never saw (RUNBOOK §10)

# ── Background loops / caches (ms) ──────────────────────────────────────────
SESSION_CLEANUP_MS=3600000         # session-cleanup processor (expired sessions, webhook payload purge)
LEDGER_CACHE_MS=15000              # Redis cache for ledger / wallet reads (reconcile always reads uncached)
EXCHANGE_STALE_AFTER_SEC=300       # GET /exchange/status reports ledger.stale when the index row was not touched for this long
ORDER_PREPARE_TTL_SEC=60           # how long a prepared order (POST /markets/:id/orders/prepare) is advertised as usable
DEPOSIT_LOCK_TTL_MS=300000         # lock:deposit:<userId> TTL — above the worst-case history walk (≥ 60000)
DEPOSIT_CONFIRM_GRACE_MS=600000    # a submitted credit younger than this is never marked failed, whatever the wallet's command index says

# ── Ledger indexer (docs/INDEXER.md) ────────────────────────────────────────
INDEXER_ENABLED=true               # false = no loop; the read API serves whatever was indexed before
INDEXER_POLL_MS=2000               # ledger-end poll once caught up
INDEXER_BATCH=200                  # updates per /v2/updates call (the participant caps at http-list-max-elements-limit)
INDEXER_ACS_LIMIT=10000            # ACS page size for bootstrap / resync; a snapshot that fills it is refused as possibly truncated
INDEXER_START_OFFSET=0             # never-pruned participant: first offset to replay (0 = the whole history)
INDEXER_LOCK_TTL_MS=30000          # cross-instance lock (lock:ledger-indexer), renewed every third
INDEXER_TRACK_TRANSFERS=true       # index Canton Coin transfers between the treasury and other parties (Splice Amulet events)
SPLICE_AMULET_PACKAGE_NAME=splice-amulet   # packageName the participant reports for Splice Amulet events
INDEXER_UPDATES_ENDPOINT=auto      # auto | updates | trees — auto falls back to the deprecated /v2/updates/trees on a 404
INDEXER_PARTY=                     # party to index as; blank = TREASURY_PARTY_ID (must be a Canton party id when set)

# ── Observability ────────────────────────────────────────────────────────────
SENTRY_DSN=
SWAGGER_ENABLED=auto               # auto (= on outside prod) | true | false — Swagger UI at /api/docs
