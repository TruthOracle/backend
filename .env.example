# TruthOracle backend — configuration reference (docs/ARCHITECTURE.md §12, src/config.ts).
# Copy to .env for local development. Every key below is read exactly once by
# getConfiguration(); the process REFUSES TO BOOT on any of these:
#   • missing DATABASE_URL / REDIS_URL / NATS_URL
#   • SESSION_SECRET / KYC_FINGERPRINT_PEPPER shorter than 32 chars, or a set
#     BACKEND_PROXY_SECRET shorter than 32 chars
#   • KYC_PROVIDER=mock when prod-like (APP_ENV=prod OR APP_NETWORK=mainnet OR RAMP_PROVIDER_MODE=live)
#   • SUMSUB_APP_TOKEN starting with "sbx:" on mainnet
#   • APP_NETWORK=mainnet without the ZKPC_* block
#   • COOKIE_DOMAIN set while BACKEND_PROXY_SECRET is configured (proxied cookies are host-only)
#   • KYC_PROVIDER=sumsub with SUMSUB_APP_TOKEN but no SUMSUB_WEBHOOK_SECRET
#   • prod-like with unverified Postgres TLS (DB_SSL=true/auto) and no DB_SSL_INSECURE_ACK
#   • COLLATERAL_INSTRUMENT_ID set without COLLATERAL_INSTRUMENT_ADMIN (or the admin without the id); an
#     instrument admin / AUDIT_OBSERVER_PARTIES entry that is not a Canton party id; *_INSTRUMENT_DECIMALS
#     outside 0..10; *_REGISTRY_AUTH outside none|ledger|keycloak; TREASURY_TRANSFER_MODE outside wallet|registry
#   • to_settings.app_network ≠ APP_NETWORK (database belongs to another network)
#   • to_settings.kyc_pepper_hash ≠ sha256(KYC_FINGERPRINT_PEPPER) without KYC_PEPPER_ROTATION_ACK
# See docs/RUNBOOK.md for the operator procedures behind each refusal.

# ── Process ──────────────────────────────────────────────────────────────────
APP_ENV=dev                        # dev | staging | prod — drives every "auto" below and Sentry environment
APP_NETWORK=devnet                 # devnet | mainnet — Redis key prefix, NATS stream name, ledger credential selection
PORT=8091                          # HTTP listen port
LOG_JSON=auto                      # auto (= JSON outside dev) | true | false — Nest ConsoleLogger({ json })

# ── Datastores (all required) ───────────────────────────────────────────────
DATABASE_URL=postgresql://truthoracle:truthoracle@localhost:5432/truthoracle_backend   # docker-compose credentials
DB_MIGRATE_ON_BOOT=true            # run the checked-in TypeORM migrations at startup (synchronize is never used)
DB_SSL=auto                        # auto (off for localhost / docker "postgres" host, unverified TLS otherwise) | true (unverified TLS) | verify (TLS, certificate checked) | false
DB_SSL_CA=                         # DB_SSL=verify only: PEM inline or a file path when the managed Postgres uses a private CA (Railway: not needed)
DB_SSL_INSECURE_ACK=false          # prod-like refuses unverified TLS (DB_SSL=true, or auto against a remote host) unless this is true
REDIS_URL=redis://localhost:6379   # sessions cache + per-user index, challenges, nonces, rate limits, locks, ledger cache
NATS_URL=nats://localhost:4222     # JetStream MUST be enabled (nats-server -js); stream TRUTHORACLE_<APP_NETWORK>
                                   # auth goes in the URL: nats://<token>@host:4222 (token, e.g. Railway's NATS) or nats://<user>:<pass>@host:4222

# ── Sessions & cookies ───────────────────────────────────────────────────────
SESSION_SECRET=change-me-to-at-least-32-random-characters-please   # ≥32 chars; generate: openssl rand -hex 32
SESSION_TTL_HOURS=168              # absolute lifetime of user sessions (kind = user)
ADMIN_SESSION_TTL_HOURS=1          # absolute lifetime of wallet-signed admin sessions (kind = admin)
COOKIE_SECURE=auto                 # auto (= Secure outside dev) | true | false
COOKIE_DOMAIN=                     # blank = host-only cookie. MUST stay blank behind the Vercel proxy.
# Origins allowed by the CSRF guard on every non-GET (exact origins or https://*.vercel.app patterns).
FRONTEND_ORIGINS=http://localhost:5173
# Shared secret with pm-frontend/api/proxy/backend.mjs (x-truthoracle-proxy). When the header
# matches, x-real-ip / x-forwarded-host are trusted; otherwise socket address + Host are used and every
# x-forwarded-* header is ignored. ≥32 chars when set; blank = never trust proxy headers.
BACKEND_PROXY_SECRET=
# CORS is only for native / non-browser clients (bearer sessions). Browser traffic is same-origin via the proxy.
CORS_ORIGINS=

# ── Google (Identity Services, ID-token flow) ───────────────────────────────
GOOGLE_CLIENT_IDS=                 # comma list of accepted audiences (web + iOS client ids)
GOOGLE_NONCE_REQUIRED=auto         # auto (= required outside dev) | true | false — POST /auth/google/nonce

# ── Telegram (Login Widget, Mini App initData, OIDC) ────────────────────────
TELEGRAM_BOT_TOKEN=                # from BotFather; HMAC key for widget/initData verification
TELEGRAM_BOT_USERNAME=             # without @; the frontend hides the widget when blank
TELEGRAM_AUTH_MAX_AGE_SEC=300      # Login Widget auth_date window
TELEGRAM_INITDATA_MAX_AGE_SEC=3600 # Mini App initData auth_date window
TELEGRAM_OIDC_CLIENT_ID=           # BotFather → Login Widget → OIDC client
TELEGRAM_OIDC_CLIENT_SECRET=       # its client secret
TELEGRAM_OIDC_ISSUER=https://oauth.telegram.org # OIDC issuer (Telegram's by default)

# ── Operators / admins ───────────────────────────────────────────────────────
# Parties allowed to hold an admin session (purpose = admin-sign-in), comma separated.
# Optional "=publicKey" pins the signing key (hex / base64 / base64url) on top of the fingerprint binding.
# Removing a party revokes its admin sessions on the next request. There is no ADMIN_EMAILS.
# SPEC §6.5 (S4): <party>[=<pinnedKey>]#<personId>@<role>[+<role>], roles ops | approver | aml | export.
# Four-eyes compares PERSONS (one person, many parties = one person). Dev / test: no #… = person is the
# party with every role; prod-like requires #person@roles on every entry and >= 2 approver persons.
ADMIN_OPERATORS=
ADMIN_OPERATOR_ACCOUNTS=                # <personId>:<user uuid>[,…] each person's own accounts: never a subject of their approvals (I8)

# ── Canton ledger + Enterprise Wallet (devnet names; mainnet uses ZKPC_* for the ledger) ──
LEDGER_API_URL=                    # Canton JSON Ledger API base (devnet); ignored on mainnet
ENTERPRISE_WALLET_URL=             # Enterprise Wallet REST base (transfer, external/submit, the transfer / command status indexes)
TREASURY_PARTY_ID=                 # party the Enterprise Wallet signs for; reads are done as this party
ENTERPRISE_WALLET_APP_NAME=truthoracle # app_name the Enterprise Wallet submissions carry
# The deployed Daml package is truthoracle-v17 1.0.0 — a fresh lineage deployed from scratch (docs/TOKENS.md §3). Every
# UserWallet carries its `instrument : InstrumentId` and `creditRefs : [Text]` (the deposit / grant confirm passes key on it;
# a UserWallet read without either field is a 502 upstream_failed), every market its `collateral`, and so are the four
# market identity fields (ticker, eventTicker, yesSubTitle, noSubTitle); the contract carries no presentation
# (image / description / category are the backend's — docs/MARKETS.md §1).
TRUTHORACLE_PACKAGE_ID=                    # package-id form for Create/Exercise commands (pins the version) — printed by `npm run dars:upload` in truthoracle-contracts
TRUTHORACLE_PACKAGE_NAME=truthoracle-v17   # daml.yaml `name:` — active-contracts filters need "#name:Module:Entity"

# ── Keycloak (client_credentials → bearer for ledger + wallet) ──────────────
KEYCLOAK_URL=                      # Keycloak base URL (devnet ledger + wallet bearers)
KEYCLOAK_REALM=master              # realm of the client below
KEYCLOAK_CLIENT_ID=                # client_credentials client for the ledger and wallet bearers
KEYCLOAK_CLIENT_SECRET=            # its secret
# Optional per-target overrides; each field falls back to KEYCLOAK_* independently.
LEDGER_KEYCLOAK_URL=               # blank = KEYCLOAK_URL
LEDGER_KEYCLOAK_REALM=             # blank = KEYCLOAK_REALM
LEDGER_KEYCLOAK_CLIENT_ID=         # blank = KEYCLOAK_CLIENT_ID
LEDGER_KEYCLOAK_CLIENT_SECRET=     # blank = KEYCLOAK_CLIENT_SECRET
WALLET_KEYCLOAK_URL=               # the wallet trusts its OWN Keycloak on every network
WALLET_KEYCLOAK_REALM=             # blank = KEYCLOAK_REALM
WALLET_KEYCLOAK_CLIENT_ID=         # blank = KEYCLOAK_CLIENT_ID
WALLET_KEYCLOAK_CLIENT_SECRET=     # blank = KEYCLOAK_CLIENT_SECRET
# Mainnet ledger (ALL required when APP_NETWORK=mainnet; the only ledger credentials read there):
ZKPC_LEDGER_API_URL=               # the zkpc JSON Ledger API base
ZKPC_KEYCLOAK_URL=                 # the zkpc Keycloak that issues the mainnet ledger bearer
ZKPC_KEYCLOAK_REALM=master         # its realm
ZKPC_KEYCLOAK_CLIENT_ID=           # our zkpc client
ZKPC_KEYCLOAK_CLIENT_SECRET=       # its secret

# ── KYC ─────────────────────────────────────────────────────────────────────
KYC_PROVIDER=mock                  # mock | sumsub — mock is refused prod-like (also RAMP_PROVIDER_MODE=live); /kyc/mock/* exists only with mock
KYC_ENFORCE_WITHDRAWALS=false      # gate external withdrawal settlement on an approved KYC (plain flag; money leaves only through this backend)
KYC_REQUIRED_LEVEL=basic-kyc-level # provider level name an approval must carry
KYC_FINGERPRINT_PEPPER=change-me-to-at-least-32-random-characters-too   # ≥32 chars; HMAC key for person/doc fingerprints
KYC_PEPPER_ROTATION_ACK=           # sha256 hex of the NEW pepper — acknowledges a pepper rotation (docs/RUNBOOK.md)
# Sumsub (docs/KYC.md §5): dashboard → Dev space → App tokens (View applicants) and Webhooks.
SUMSUB_BASE_URL=https://api.sumsub.com   # same host for sandbox and production; the token decides
SUMSUB_APP_TOKEN=                  # "sbx:" tokens are refused on mainnet
SUMSUB_SECRET_KEY=                 # the app token's secret (shown once at creation)
SUMSUB_WEBHOOK_SECRET=             # webhook secret key; required with KYC_PROVIDER=sumsub once SUMSUB_APP_TOKEN is set (boot refusal otherwise)
SUMSUB_DUPLICATE_LABELS=DUPLICATE  # reject labels that map to blocked_duplicate
SUMSUB_ALLOW_SHA1=false            # accept HMAC_SHA1_HEX webhook digests — Sumsub's DEFAULT is SHA-1, so set the dashboard webhook to HMAC_SHA256_HEX instead
# Probe the wiring from the host: `npm run kyc:check` (or GET /admin/kyc/provider with an operator session).

# ── Payout policy (closed map — anything else is blocked_unknown_reason) ────
PAYOUT_EXTERNAL_REASONS=withdraw   # settled as token transfers in the payout's instrument (TREASURY_TRANSFER_MODE), KYC-gated
PAYOUT_INAPP_REASONS=bond,model-prize   # settled into the payee's in-app UserWallet
PAYOUT_MAX_ATTEMPTS=5              # settling attempts before a row becomes failed (admin queue); system scans never count
PAYOUT_SCAN_MS=30000               # payout-settlement processor scan interval
PAYOUT_RESEND_GRACE_MS=600000      # row age before an operator's force may re-send a transfer the wallet says it never saw (RUNBOOK §10)

# ── Background loops / caches (ms) ──────────────────────────────────────────
SESSION_CLEANUP_MS=3600000         # session-cleanup processor (expired sessions, webhook payload purge)
LEDGER_CACHE_MS=15000              # Redis cache for ledger / wallet reads (reconcile always reads uncached)
EXCHANGE_STALE_AFTER_SEC=300       # GET /exchange/status reports ledger.stale when the index row was not touched for this long
ORDER_PREPARE_TTL_SEC=60           # how long a prepared order (POST /markets/:id/orders/prepare) is advertised as usable
DEPOSIT_LOCK_TTL_MS=300000         # lock:deposit:<userId> TTL — above the worst-case reconcile (confirm pass + ledger reads + submit; ≥ 60000)
DEPOSIT_CONFIRM_GRACE_MS=600000    # a submitted credit (or reward grant, docs/TOKENS.md §4.6) younger than this is never marked failed, whatever the wallet's command index says

# ── Ledger indexer (docs/INDEXER.md) ────────────────────────────────────────
INDEXER_ENABLED=true               # false = no loop; the read API serves whatever was indexed before
INDEXER_POLL_MS=2000               # ledger-end poll once caught up
INDEXER_BATCH=200                  # updates per /v2/updates call (the participant caps at http-list-max-elements-limit)
INDEXER_ACS_LIMIT=10000            # ACS page size for bootstrap / resync; a snapshot that fills it is refused as possibly truncated
INDEXER_START_OFFSET=0             # never-pruned participant: first offset to replay (0 = the whole history)
INDEXER_LOCK_TTL_MS=30000          # cross-instance lock (lock:ledger-indexer), renewed every third
SPLICE_AMULET_PACKAGE_NAME=splice-amulet   # packageName the participant reports for Splice Amulet events (Canton Coin transfers; token-standard transfers are always indexed)
INDEXER_PARTY=                     # party to index as; blank = TREASURY_PARTY_ID (must be a Canton party id when set)

# ── Instruments (CIP-56, docs/TOKENS.md §4.1). The two below are upserted into to_instruments at boot. ──
# Blank COLLATERAL_INSTRUMENT_ID = no collateral configured (markets cannot be created until one is).
# DevNet stand-in until Cantor8 deploys cBYN: Canton Coin — admin = the DSO party
# (DSO::1220be58c29e65de40bf273be1dc2b266d43a9a002ea5b18955aeef7aac881bb471a), id Amulet, symbol CC, 10 decimals,
# registry = the validator's scan proxy with COLLATERAL_REGISTRY_AUTH=ledger.
# DevNet cBYN transfer agent (Cantor8, 2026-10-16): truthoracle-cbyn-transfer-agent::12204e94c0e449c0efcd270dd1e68259c36471cebef132e5c7dfc2750fe8c9eed77f
COLLATERAL_INSTRUMENT_ADMIN=            # cBYN: the transfer-agent party (from Cantor8). DevNet stand-in: the DSO party
COLLATERAL_INSTRUMENT_ID=cBYN           # DevNet stand-in: Amulet
COLLATERAL_INSTRUMENT_SYMBOL=cBYN       # display symbol (stand-in: CC); blank = the instrument id
COLLATERAL_INSTRUMENT_NAME=Canton Belarusian Ruble   # blank = the instrument id
COLLATERAL_INSTRUMENT_DECIMALS=6        # cBYN 6; Canton Coin 10 — display and withdrawal quantisation (storage stays 10 dp)
COLLATERAL_REGISTRY_URL=https://token-registry.dev.digik.cantor8.tech/api/c8   # stand-in: https://api.validator.dev.digik.cantor8.tech/api/validator/v0/scan-proxy
COLLATERAL_REGISTRY_AUTH=keycloak       # none | ledger (the ledger bearer — scan proxy) | keycloak (REGISTRY_KEYCLOAK_*)
COLLATERAL_WALLET_INSTRUMENT_ID=        # what the Cantor8 wallet SDK's send() expects; blank = the instrument id
# The rewards instrument (TRO). A blank REWARDS_INSTRUMENT_ADMIN leaves rewards idle (TRO is not deployed on DevNet yet).
REWARDS_INSTRUMENT_ADMIN=
REWARDS_INSTRUMENT_ID=TRO               # token id
REWARDS_INSTRUMENT_SYMBOL=TRO           # display symbol; blank = the instrument id
REWARDS_INSTRUMENT_NAME=TruthOracle Token # blank = the instrument id
REWARDS_INSTRUMENT_DECIMALS=6             # 0..10 (TRO 6)
REWARDS_REGISTRY_URL=                     # TRO's registry base URL (blank until TRO is deployed)
REWARDS_REGISTRY_AUTH=keycloak            # none | ledger | keycloak (as COLLATERAL_REGISTRY_AUTH)
REWARDS_WALLET_INSTRUMENT_ID=             # blank = the instrument id
AUDIT_OBSERVER_PARTIES=                 # regulator parties, comma separated: observers on wallets, payouts and new markets
TREASURY_TRANSFER_MODE=wallet           # wallet (Enterprise Wallet /api/v1/transfer) | registry (TransferFactory_Transfer via /external/submit); per-instrument transfer_mode overrides
TREASURY_TRANSFER_TTL_SEC=600           # executeBefore for registry-mode transfers
LEDGER_FRESH_OFFSETS=50                 # reconcile refuses (503 ledger_stale) when the index lags the ledger end by more than this
ACCEPTOR_SCAN_MS=10000                  # TransferInstruction acceptor cadence (0 = off; otherwise ≥ 1000)
REGISTRY_KEYCLOAK_URL=                  # bearer for registry_auth=keycloak; devnet: each falls back to KEYCLOAK_*; mainnet: these only (realm default master)
REGISTRY_KEYCLOAK_REALM=                # blank = KEYCLOAK_REALM (devnet) / master (mainnet)
REGISTRY_KEYCLOAK_CLIENT_ID=            # blank = KEYCLOAK_CLIENT_ID (devnet only)
REGISTRY_KEYCLOAK_CLIENT_SECRET=        # blank = KEYCLOAK_CLIENT_SECRET (devnet only)
# ── token-app (Cantor8 mint/burn, docs/TOKENS.md §4.4) ──
TOKEN_APP_URL=                          # blank = every mint / burn answers 503 token_app_unconfigured. DevNet instance pending from Cantor8; MainNet https://token-app.main.zkpc.cantor8.tech
TOKEN_APP_APP_NAME=truthoracle          # app_name on token-app mint / burn requests
TOKEN_APP_KEYCLOAK_URL=                 # devnet: falls back to KEYCLOAK_*; mainnet: required, Cantor8's dedicated client only (https://auth.main.zkpc.cantor8.tech)
TOKEN_APP_KEYCLOAK_REALM=               # blank = master
TOKEN_APP_KEYCLOAK_CLIENT_ID=           # mainnet: must differ from KEYCLOAK_CLIENT_ID / WALLET_KEYCLOAK_CLIENT_ID
TOKEN_APP_KEYCLOAK_CLIENT_SECRET=       # its secret
# ── token-app command ledger + sync (docs/RAMP.md §7; S1) ──
TOKEN_APP_MAX_PER_CALL=                 # largest single mint / burn (decimal, instrument units); required prod-like with RAMP_ENABLED or a TOKEN_APP_URL
TOKEN_APP_MAX_PER_DAY=                  # rolling 24 h Σ mints of one instrument, every source; required prod-like with RAMP_ENABLED or a TOKEN_APP_URL
TOKEN_APP_SYNC_SEC=60                   # token-app mirror sync while a command is unresolved (0 = off; refused prod-like with the ramp on or a TOKEN_APP_URL)
TOKEN_APP_RESEND_MAX_AGE_HOURS=144      # an approved re-send only while the last POST is younger (1..167: inside the 7-day dedup window)
RAMP_TOKEN_CONFIRM_MIN=15               # an unresolved mint / burn is amber after this (from its last POST)
RAMP_TOKEN_REVIEW_AFTER_MIN=120         # ...and its order goes to review after this
# TOKENAPP_CHECK_MAINNET=               # script only: I_UNDERSTAND_REAL_CBYN lets `npm run tokenapp:check --roundtrip` run on mainnet (with --ack-mainnet)
# ── Rewards (TRO, docs/TOKENS.md §4.6) ──
REWARDS_ENABLED=true                    # the RewardsProcessor loop (rules are toggled individually under /admin/rewards/rules)
REWARDS_SCAN_MS=30000                   # rewards pass cadence (ms) while REWARDS_ENABLED
REWARDS_AUTO_MINT=false                 # DevNet only (refused on mainnet): mint the float shortfall through token-app instead of blocking the grant
REWARDS_MINT_MIN=1000                   # smallest auto-mint, in the rewards instrument
# ── Fiat ramp: BYN card / ERIP on-ramp, card / bank cash-out (docs/RAMP.md §10) ──
RAMP_ENABLED=false                      # kill switch for NEW orders; in-flight orders always finish
RAMP_PROVIDER=mock                      # mock (dev/test; refused with RAMP_ENABLED in prod / on mainnet) | <bank adapter, once chosen>
RAMP_INSTRUMENT=                        # <admin party>:<token id>; blank = the default collateral (cBYN)
RAMP_FIAT_CURRENCY=BYN                  # ISO 4217 code of the fiat side
RAMP_FIAT_DECIMALS=2                    # fiat minor units (kopecks: 2; 0..4)
RAMP_PUBLIC_APP_URL=                    # frontend origin; the hosted checkout returns to <this>/wallet/ramp/<order id>
RAMP_PUBLIC_API_URL=                    # public API base the acquirer posts webhooks to: <this>/webhooks/ramp/<provider>
RAMP_REQUIRE_KYC=true                   # KYC for card payments and cash-outs, whatever KYC_ENFORCE_WITHDRAWALS says
RAMP_REQUIRE_3DS=true                   # a capture without 3-D Secure goes to needs_review
RAMP_ONRAMP_MIN=10                      # BYN per order
RAMP_ONRAMP_MAX=2000                    # BYN per order
RAMP_ONRAMP_DAILY_MAX=3000              # rolling 24 h per account
RAMP_ONRAMP_MONTHLY_MAX=20000           # rolling 30 days per account
RAMP_OFFRAMP_MIN=10                     # BYN per order
RAMP_OFFRAMP_MAX=2000                   # BYN per order
RAMP_OFFRAMP_DAILY_MAX=3000             # rolling 24 h per account
RAMP_OFFRAMP_MONTHLY_MAX=20000          # rolling 30 days per account
RAMP_MAX_CARDS=3                        # active cards per account; a card belongs to one account
RAMP_OFFRAMP_SIGN_TTL_MIN=15            # minutes to sign the cash-out withdrawal in the wallet
RAMP_SCAN_MS=10000                      # processor cadence; 0 = off, which also stops reconciliation, re-screens, TM-FROZEN-ACTIVITY and bank aging (refused prod-like; pause with POST /admin/ramp/controls/halt)
RAMP_MAX_ATTEMPTS=5                     # per step, then needs_review
RAMP_STUCK_AFTER_MIN=30                 # reconciliation flags orders unchanged for longer
RAMP_MOCK_WEBHOOK_SECRET=               # mock only; blank = derived from SESSION_SECRET
# -- fiat ramp core (SPEC §13 S2) --
RAMP_CHECKOUT_HOSTS=                    # hosts a hosted-checkout redirect may point at (https only); required with a real provider; the mock uses RAMP_PUBLIC_APP_URL's
RAMP_WITHDRAWING_TIMEOUT_MIN=60         # a bound withdrawal whose MarkPaid never ran goes to review after this (deferrals excluded)
RAMP_WITHDRAWAL_BIND_GRACE_MIN=10       # an unsigned cash-out past its deadline waits this long for a withdrawal signed in time to bind; 0 = expire at the deadline
RAMP_CREDIT_BACK_FINAL_AFTER_MIN=60     # a credit-back Deposit the wallet reports failed counts as never landing only this long after its last submission; integer ≥ 1, longer than any ledger command lifetime
RAMP_EVENT_DEAD_AFTER_HOURS=72          # a webhook still failing after this is dead: no more retries, the reconciliation shows it
RAMP_CREATED_STALE_MIN=5                # a `created` on-ramp this old is looked up at the acquirer (adopted, or failed); > the adapter's 30 s HTTP timeout
RAMP_CLOSED_POLL_HOURS=48               # closed and completed card on-ramps are re-read this long (late captures, chargebacks); 0 refused prod-like
# -- methods, rails, card cash-out, exposure, operator of record (SPEC §9, §13 S5) --
RAMP_METHODS=card                       # card | erip (comma list); must be methods the acquirer offers; erip needs RAMP_PAYOUT_RAILS ∋ bank prod-like
RAMP_PAYOUT_RAILS=card                  # card (back to the funding card) | bank (S6's batches); the acquirer without card cash-out needs bank prod-like
RAMP_CARD_TTL_MIN=30                    # a card checkout is open this long
RAMP_CARD_FEE_BPS=0                     # customer fee of a card purchase: bps of the amount + fixed (BYN)
RAMP_CARD_FEE_FIXED=0                   # BYN per card purchase
RAMP_CARD_PSP_FEE_BPS=240               # PSP fee accrued per card capture when the acquirer reports none (journal psp.fee_accrued)
RAMP_ERIP_TTL_MIN=1440                  # an ERIP invoice is open this long
RAMP_ERIP_FEE_BPS=0                     # customer fee of an ERIP purchase: bps of the amount + fixed (BYN)
RAMP_ERIP_FEE_FIXED=0                   # BYN per ERIP purchase
RAMP_ERIP_PSP_FEE_BPS=120               # PSP fee accrued per ERIP capture when the acquirer reports none
RAMP_PAYOUT_CARD_FEE_BPS=0              # customer fee of a cash-out to the card: bps + fixed (BYN)
RAMP_PAYOUT_CARD_FEE_FIXED=0            # BYN per card cash-out
RAMP_PAYOUT_BANK_FEE_BPS=0              # customer fee of a cash-out to a bank account
RAMP_PAYOUT_BANK_FEE_FIXED=0            # BYN per bank cash-out
RAMP_CARD_REFUND_MAX_DAYS=180           # card cash-out refunds only captures younger than min(this, the acquirer's window)
RAMP_CARD_EXPOSURE_DAYS=120             # card captures this recent limit bank payouts, OCTs and plain withdrawals (dispute window); 0 refused prod-like
RAMP_CARD_PAYOUT_COUNTRIES=BY           # issuer countries an OCT (the card cash-out fallback) may pay
RAMP_DEEPLINK_SCHEMES=                  # bank-app link schemes ERIP details may carry (never javascript/data/http/https; https needs RAMP_CHECKOUT_HOSTS)
RAMP_MOCK_ERIP_SERVICE_CODE=100001      # the mock acquirer's ERIP service code (digits)
RAMP_OPERATOR_NAME=                     # operator of record, stamped on every order; required with the ramp on prod-like
RAMP_OPERATOR_UNP=                      # its 9-digit UNP (= RAMP_BANK_HOLDER_UNP: the operator holds the client money)
RAMP_OPERATOR_HTP_REF=                  # its HTP residency reference
RAMP_TERMS_VERSION=                     # the terms every order is made under (consent, S7a); required prod-like
RAMP_TERMS_URL=                         # https URL of those terms; required prod-like

# ── Platform security: sealing keyrings, provider mode, webhook sources (SPEC §8; S3) ──
# Sealed columns (card tokens, IBANs, identities, statement lines) and blind indexes. <kid>:<base64 32 bytes>[,…]
# (openssl rand -base64 32). Rotate: add a kid, make it active, let the re-seal job finish, then drop the old kid —
# boot refuses a keyring that drops a kid rows still use. Blank pairs = derived from SESSION_SECRET (dev/test only).
DATA_KEYS=                              # required prod-like (APP_ENV=prod, APP_NETWORK=mainnet or RAMP_PROVIDER_MODE=live)
DATA_KEY_ID=                            # the active kid of DATA_KEYS
DATA_INDEX_KEYS=                        # HMAC keys for blind indexes; never a DATA_KEYS key; a kid ERIP payer hashes use stays (not re-indexable)
DATA_INDEX_KEY_ID=                      # the active kid of DATA_INDEX_KEYS
RAMP_PROVIDER_MODE=sandbox              # sandbox | live (live = prod-like; the mock is always sandbox)
RAMP_IP_AUTH_PROVIDERS=                 # providers that authenticate webhooks by source IP (e.g. webpay); each needs CIDRs below
RAMP_WEBHOOK_SOURCE_CIDRS=              # <provider>:<cidr>[,…], e.g. webpay:203.0.113.0/24
RAMP_WEBHOOK_IP_HEADER=                 # header carrying the client IP (right-most value), e.g. x-forwarded-for
RAMP_TRUSTED_EDGE_CIDRS=                # socket peers allowed to set that header (or the BACKEND_PROXY_SECRET relay)

# ── Controls: halts, reconciliation, reserve / payout gates, four-eyes approvals (SPEC §6; S4) ──
RAMP_DUAL_CONTROL=true                  # money-moving admin actions need a second PERSON (false = execute at once; refused prod-like)
RAMP_APPROVAL_SIGNATURES=true           # decisions carry the operator wallet's signature over truthoracle-approval:<id>:<params_hash>:<approve|reject> (refused off prod-like)
RAMP_APPROVAL_TTL_BDAYS=2               # a pending approval expires at 23:59:59 Minsk of the Nth Belarusian business day
RAMP_RECON_EVERY_MIN=15                 # full reconciliation cadence (also the idle token-sync cadence)
RAMP_RECON_MAX_AGE_MIN=60               # the reserve and payout gates need a full run younger than this (>= RAMP_RECON_EVERY_MIN)
RAMP_RECON_UNKNOWN_MAX_MIN=60           # a halting check unreadable for longer counts as red for its halt scopes
RAMP_AUTO_HALT=true                     # red halting checks halt their scopes at once (refused off prod-like)
RAMP_RESERVE_GATE=enforce               # enforce | warn (alert only) | off (off-prod only); before every mint and re-mint
RAMP_PAYOUT_GATE=enforce                # enforce | warn | off: the payout gate's reconciliation conditions (halts always block); prod-like enforce
RAMP_RESERVE_MAX_AGE_BDAYS=2            # the latest confirmed statement's period end may be this many business days old
RAMP_RESERVE_TOLERANCE=0                # allowed reserve shortfall (BYN); > 0 refused prod-like
RAMP_MINT_DAILY_CAP=                    # rolling 24 h ramp mints (cBYN, re-mints excluded); required prod-like with RAMP_ENABLED or a TOKEN_APP_URL
RAMP_PSP_SETTLE_DAYS=3                  # captures older than this many business days should be settled (provider_clearing_aging, amber)
RAMP_OPERATOR_MONEY_MAX=                # BYN of operator money the client account may hold past a business day (blank = no check)
RAMP_TREASURY_SURPLUS_MAX=              # treasury holdings above the in-app liabilities by more than this are amber (blank = no check)
# Belarusian calendar (Minsk, UTC+3): statutory holidays of 2026 (Radunitsa = 2026-04-21); add the transferred
# days off and list the transferred working Saturdays from the Council of Ministers' yearly resolution.
RAMP_BANK_HOLIDAYS=2026-01-01,2026-01-02,2026-01-07,2026-03-08,2026-04-21,2026-05-01,2026-05-09,2026-07-03,2026-11-07,2026-12-25
RAMP_BANK_WORKDAYS=                     # transferred working Saturdays (ISO dates, comma list)

# ── Compliance: identity, consent, eligibility, monitoring rules, alerts (SPEC §11, §13; S7a) ──
# Every threshold is data (ПВК p.64 indicators lowered to product scale; counsel confirms). BV = base value.
RAMP_COMPLIANCE=on                      # on | off: off (off-prod only) allows everyone and holds nothing; refused prod-like, ramp on or off
RAMP_BV_TABLE=2026-01-01:45             # dated BV in BYN, <YYYY-MM-DD>:<BYN>[,…] ascending; the value in force at the operation date (Minsk) applies
RAMP_MIN_AGE=18                         # account holders under this age are not eligible (below 18 refused prod-like)
RAMP_ALLOWED_RESIDENCE=BY               # ISO alpha-2 residence countries served
RAMP_BLOCKED_CITIZENSHIPS=              # ISO alpha-2 citizenships refused
RAMP_KYC_REFRESH_DAYS=30                # a stored identity older than this is re-read from the KYC provider (provider down = not eligible)
RAMP_ERIP_ALLOW_CASH=true               # an ERIP cash / unknown-channel payment is a review (TM-CASH); false = block
RAMP_TM_RULES_VERSION=                  # the internal-control (ПВК) rules version stamped on every alert; required prod-like with the ramp on
RAMP_TM_ALLOW_UNREACHABLE=false         # true accepts a rule threshold the limits can never reach (refused at boot prod-like otherwise)
RAMP_TM_STRUCT_COUNT=3                  # TM-STRUCT: this many on-ramps in 24 h …
RAMP_TM_STRUCT_PCT=90                   # … summing to this % of RAMP_ONRAMP_DAILY_MAX
RAMP_TM_AGE_BV=100                      # TM-AGE: under 21 or 60+ and this many BV of on- + off-ramps in 30 days
RAMP_TM_THIRDPARTY_BV=20                # TM-THIRDPARTY: a bank-supplied payer name unlike every verified name form; review from this BV, info below
RAMP_TM_UNVERIFIED_PAYER_BV=100         # payer_unverified: ERIP without a bank payer name; info below this BV per 30 days, review from it
RAMP_TM_ROUNDTRIP_DAYS=30               # TM-ROUNDTRIP: on-ramps in this many days …
RAMP_TM_ROUNDTRIP_BV=50                 # … of at least this many BV …
RAMP_TM_ROUNDTRIP_TRADE_PCT=10          # … then a cash-out with trading at most this % of them
RAMP_TM_NETOUT_BV=200                   # TM-NETOUT: 30-day cash-outs beyond on-ramps and deposits by more than this many BV
RAMP_TM_MAX_CARDS_30D=3                 # TM-CARDS: more distinct cards paying in 30 days is a review

# ── Screening and freezes (SPEC §11.6, §13; S7b) ──
RAMP_RESCREEN_DAYS=30                   # every account (dormant ones too) is re-screened against the latest lists this often (1..90; ПВК: at least every 3 months)
RAMP_SCREENING_LIST_MAX_AGE_DAYS=30     # screening_stale is amber when by_terror / un / decree48 was not imported for longer (import each list the day it is delivered)

# ── Bank rail: client-money account, user accounts, payout batches, statements (SPEC §10, §13; S6) ──
# Prod-like with RAMP_ENABLED: the client-money account below is required (statements feed the reserve gate), held by
# the operator of record (RAMP_BANK_HOLDER_UNP = RAMP_OPERATOR_UNP). It is the ONE account: the operator's own money
# sits in it too, and its own payments in / out are classified operator_topup / operator_sweep four-eyes (a sweep never
# past the client liabilities).
RAMP_BANK_ACCOUNT_IBAN=                 # the CLIENT-MONEY account (BY IBAN): the only account whose statements are imported; the payer of every payout
RAMP_BANK_BIC=                          # its bank's BIC (first 4 = the IBAN's bank code)
RAMP_BANK_NAME=                         # its bank's name, as payment orders show it
RAMP_BANK_HOLDER_NAME=                  # the account holder (the operator of record) as the bank file names the payer
RAMP_BANK_HOLDER_UNP=                   # its 9-digit UNP; must equal RAMP_OPERATOR_UNP (Decree 367)
RAMP_PSP_SETTLEMENT_IBANS=              # the acquirer's accounts: credits from them book psp.settlement (+ the fee true-up), debits psp.funding
RAMP_BANK_PAYOUT_PURPOSE_CODE=40109     # КНП of payouts and refunds (5 digits; to confirm with the bank)
# Purpose texts of a payout and of an on-ramp's bank refund ({ref} = TO-…); letters, digits and . , ' " № # ( ) / : - only.
RAMP_BANK_PAYOUT_PURPOSE_TEXT="Выплата по заказу {ref}" # a payout
RAMP_BANK_REFUND_PURPOSE_TEXT="Возврат средств по заказу {ref}" # an on-ramp's bank refund
RAMP_BANK_ACCOUNT_COOLOFF_HOURS=24      # a new user bank account waits this long before it can be proved (≥ 1 prod-like)
RAMP_MAX_BANK_ACCOUNTS=2                # non-removed bank accounts per user (5 adds per rolling 24 h at most)
RAMP_BANK_FIRST_PAYOUT_MAX=500          # BYN that may be in flight to an account before its first payout completed
RAMP_BANK_NAME_CHECKED=false            # true: the bank confirmed it refuses name mismatches for individuals (proof bank_name_check)
RAMP_BANK_MANUAL_PROOF=false            # true: operators may prove accounts by hand (four-eyes ramp.bank_account.verify)
# Prod-like refuses RAMP_PAYOUT_RAILS ∋ bank unless one of the two above is true (X10).
RAMP_BANK_BATCH_MAX=500                 # items per payout batch
RAMP_BANK_SETTLE_DAYS=3                 # business days after submission a payout's debit must show (then needs_review; bank_unpaid / void proofs)
RAMP_BANK_UNMATCHED_DAYS=3              # an unbooked statement line older than this many business days is amber
RAMP_BANK_RETURN_FEE_MAX=0              # BYN a bank return may be short of the payout (the difference books to bank_fees)
RAMP_BANK_FEE_MAX=                      # BYN: a debit without counterparty up to this books as a bank fee (blank = never automatic; classify)
RAMP_BLOCKED_BANK_CODES=                # IBAN bank codes refused for user accounts (comma list, e.g. MMBN); the directory carries sanctions flags

# ── Observability ────────────────────────────────────────────────────────────
SENTRY_DSN=
SWAGGER_ENABLED=auto               # auto (= on outside prod) | true | false — Swagger UI at /api/docs
